@if (_imageState is not ImageState.Error)
{
    <div class="image-container">
        @if (_imageState is ImageState.Loading)
        {
            <div class="image-shimmer"></div>
        }
        else
        {
            <img src=@ImageBytesToBase64(_imageBytes) />
        }
    </div>

    <div class="lpr-container">
        <div>
            @switch (_lprState)
            {
                case LprState.Loading:
                    <h3>Loading...</h3>
                    break;
                case LprState.Received:
                    <p>
                        @if (_licensePlateResult is not null)
                        {
                            @_licensePlateResult.Text
                        }
                        else
                        {
                            <span>No Plate Found</span>
                        }
                    </p>
                    break;
                case LprState.Error:
                    <h3>Error Getting License Plate</h3>
                    break;
            }
        </div>
        <button onclick="@GetLicensePlate()">Test Lpr</button>
    </div>
}
else
{
    <div class="image-error">Error Starting Live Feed</div>
}

@code {
    private ImageService _imageService = new();
    private LicensePlateService _licensePlateService = new();

    private byte[] _imageBytes = [];
    private ImageState _imageState;
    
    private LicensePlateResult? _licensePlateResult;
    private LprState _lprState = LprState.Received;
    
    protected override void OnInitialized()
    {
        _imageState = ImageState.Loading;
        _imageService.ImageReceived += OnImageReceived;
    }
    
    private void OnImageReceived(object? sender, ImageEventArgs e)
    {
        _imageBytes = e.ImageBytes;
        _imageState = e.ErrorRetrievingImage ? ImageState.Error : ImageState.Received;
        StateHasChanged();
    }
    
    private async Task GetLicensePlate() 
    {
        try
        {
            _lprState = LprState.Loading;
            _licensePlateResult = await _licensePlateService.GetLicensePlateFromImage(_imageBytes);
            _lprState = LprState.Received;
        }
        catch (Exception ex)
        {
            _lprState = LprState.Error;
        }
    }

    enum ImageState
    {
        Loading,
        Error,
        Received
    }

    enum LprState
    {
        Loading,
        Error,
        Received
    }

    private static string ImageBytesToBase64(byte[] imageBytes)
    {
        return string.Empty;
    }
}